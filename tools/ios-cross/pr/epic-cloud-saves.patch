diff -ruN a/tests/host/check-epic-cloud.py b/tests/host/check-epic-cloud.py
--- a/tests/host/check-epic-cloud.py	1970-01-01 01:00:00.000000000 +0100
+++ b/tests/host/check-epic-cloud.py	2026-10-15 18:57:18.145523945 +0200
@@ -0,0 +1,180 @@
+#!/usr/bin/env python3
+"""Epic Cloud saves, checked against Legendary's own reader and writer (Linux or macOS).
+
+Compiles the production app/Madeira/Epic/EpicCloudSaves.swift (with EpicChunk.swift and
+EpicManifest.swift) with swiftc into a host driver, then:
+
+  1. selftest        the decision table, filters, save-folder variables, chunk basics;
+  2. Swift -> Legendary   the driver uploads a synthetic save to a directory standing in for
+                          Epic's service, and Legendary's Manifest/Chunk classes read it back:
+                          every file must come out byte for byte, every chunk's rolling hash and
+                          SHA-1 must be right, and Legendary's own manifest checks must pass;
+  3. Legendary -> Swift   Legendary's SaveGameHelper writes a snapshot, the driver downloads it.
+
+Needs a Swift toolchain and a copy of Legendary (github.com/derrod/legendary) in $LEGENDARY_SRC
+(default ~/ref/legendary); without Legendary only step 1 runs. Legendary needs pycryptodomex for
+AES, which saves never use, so a stub stands in for it.
+"""
+import hashlib, os, shutil, subprocess, sys, tempfile, types
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+LEG = Path(os.environ.get("LEGENDARY_SRC", Path.home() / "ref" / "legendary"))
+EPIC = ROOT / "app" / "Madeira" / "Epic"
+failures = 0
+
+
+def check(ok, what):
+    global failures
+    print(("ok   " if ok else "FAIL ") + what)
+    if not ok:
+        failures += 1
+
+
+def build(work):
+    swiftc = shutil.which("swiftc") or str(Path.home() / "tools/swift/usr/bin/swiftc")
+    src = work / "src"
+    src.mkdir()
+    for name in ("EpicChunk.swift", "EpicManifest.swift", "EpicCloudSaves.swift"):
+        text = (EPIC / name).read_text(encoding="utf-8")
+        if sys.platform != "darwin":   # Linux splits URLSession into FoundationNetworking
+            text = text.replace("import Foundation\n", "import Foundation\n#if canImport(FoundationNetworking)\nimport FoundationNetworking\n#endif\n", 1)
+        (src / name).write_text(text, encoding="utf-8")
+    shutil.copy(Path(__file__).parent / "epic-cloud" / "main.swift", src / "main.swift")
+    args = [swiftc, "-O", "-swift-version", "5", "-o", str(work / "driver")]
+    if sys.platform != "darwin":   # no zlib module on Linux: describe the system header
+        mod = work / "zlibmod"
+        mod.mkdir()
+        (mod / "module.modulemap").write_text('module zlib [system] {\n header "/usr/include/zlib.h"\n link "z"\n export *\n}\n')
+        args += ["-I", str(mod)]
+    args += [str(p) for p in sorted(src.glob("*.swift"))]
+    r = subprocess.run(args, capture_output=True, text=True)
+    if r.returncode:
+        print(r.stdout[-3000:], r.stderr[-6000:])
+        sys.exit("FAIL: the Swift sources did not compile")
+    return work / "driver"
+
+
+def sha1(b):
+    return hashlib.sha1(b).hexdigest()
+
+
+def make_save(root: Path):
+    """A save folder with the shapes that matter: tiny, empty, nested, unicode, and bigger than a chunk."""
+    files = {
+        "slot1.sav": os.urandom(5000),
+        "empty.bin": b"",
+        "Profiles/main/profile.dat": os.urandom(100_000),
+        "Profiles/zz/ünïcode-名前.sav": b"unicode name " * 100,
+        "big/world.dat": os.urandom(2_500_000) + b"\0" * 700_000,        # spans 4 chunks, has compressible tail
+        "exactly-one-chunk.bin": os.urandom(1024 * 1024),
+        "Alpha.txt": b"sorting is case-insensitive",
+    }
+    for rel, data in files.items():
+        p = root / rel
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_bytes(data)
+    return files
+
+
+def legendary_modules():
+    sys.path.insert(0, str(LEG))
+    crypto = types.ModuleType("Cryptodome")
+    cipher = types.ModuleType("Cryptodome.Cipher")
+    cipher.AES = None
+    sys.modules.update({"Cryptodome": crypto, "Cryptodome.Cipher": cipher})
+    from legendary.models.chunk import Chunk
+    from legendary.models.manifest import Manifest
+    from legendary.utils.rolling_hash import get_hash
+    from legendary.utils.savegame_helper import SaveGameHelper
+    return Chunk, Manifest, get_hash, SaveGameHelper
+
+
+def main():
+    work = Path(tempfile.mkdtemp(prefix="epic-cloud-check-"))
+    try:
+        driver = build(work)
+        r = subprocess.run([str(driver), "selftest"], capture_output=True, text=True)
+        print(r.stdout.rstrip())
+        check(r.returncode == 0, "selftest")
+
+        if not (LEG / "legendary" / "models" / "chunk.py").exists():
+            print(f"SKIP: Legendary not found in {LEG}; set LEGENDARY_SRC for the round-trip checks")
+            return
+        Chunk, Manifest, get_hash, SaveGameHelper = legendary_modules()
+        app, acct, folder = "TestApp", "0123456789abcdef0123456789abcdef", "{AppData}/Test/Saved"
+
+        # 2. Swift writes, Legendary reads
+        src, cloud = work / "device", work / "cloud"
+        files = make_save(src)
+        r = subprocess.run([str(driver), "pack", str(src), str(cloud), app, acct, folder, "2026.10.15-12.30.45"], capture_output=True, text=True)
+        print(r.stdout.strip(), r.stderr.strip())
+        check(r.returncode == 0, "driver packed a save")
+        game = cloud / acct / "savesync" / app
+        manifests = sorted((game / "manifests").glob("*.manifest"))
+        check(len(manifests) == 1 and manifests[0].name == "2026.10.15-12.30.45.manifest", "one manifest, named by its build version")
+        m = Manifest.read_all(manifests[0].read_bytes())
+        check(m.meta.app_name == app + acct, "manifest app name is app + account (as Legendary writes it)")
+        check(m.meta.build_version == "2026.10.15-12.30.45", "build version")
+        check(m.custom_fields["CloudSaveFolder"] == folder, "CloudSaveFolder custom field")
+        check(len(m.file_manifest_list.elements) == len(files), f"manifest lists {len(files)} files")
+        chunks = {}
+        for ci in m.chunk_data_list.elements:
+            blob = (game / ci.path).read_bytes()
+            check(len(blob) == ci.file_size, f"chunk {ci.path[-20:]} file size matches the manifest")
+            c = Chunk.read_buffer(blob)
+            data = c.data
+            ok = (len(data) == 1024 * 1024 and c.guid == ci.guid and c.hash == ci.hash == get_hash(data)
+                  and c.sha_hash == ci.sha_hash == hashlib.sha1(data).digest() and ci.window_size == len(data))
+            check(ok, f"chunk {ci.guid_str[:8]}: guid, rolling hash, SHA-1 and size agree")
+            chunks[c.guid_num] = data
+        for fm in m.file_manifest_list.elements:
+            got = b"".join(chunks[cp.guid_num][cp.offset:cp.offset + cp.size] for cp in fm.chunk_parts)
+            want = files[fm.filename]
+            check(got == want and fm.hash == hashlib.sha1(want).digest() and fm.file_size == len(want),
+                  f"file {fm.filename!r} comes back byte for byte, hash and size right")
+        check(sorted(fm.filename for fm in m.file_manifest_list.elements) == sorted(files),
+              "the manifest names exactly the files that were saved")
+        names = [fm.filename for fm in m.file_manifest_list.elements]
+        check(names == sorted(names, key=str.casefold), "files are in Legendary's case-insensitive order")
+        # round trip through Legendary's own serializer: it must accept what we wrote
+        again = Manifest.read_all(m.write())
+        check(len(again.file_manifest_list.elements) == len(files), "Legendary can re-serialise and re-read the manifest")
+
+        # 3. Legendary writes, Swift reads
+        dev2, cloud2, back = work / "device2", work / "cloud2", work / "backup2"
+        files2 = make_save(dev2)
+        sgh = SaveGameHelper()
+        from datetime import datetime
+        packed = sgh.package_savegame(str(dev2), app, acct, folder, "", None, None, datetime(2026, 10, 14, 8, 0, 0))
+        game2 = cloud2 / acct / "savesync" / app
+        for rel, fp in packed.items():
+            t = game2 / rel
+            t.parent.mkdir(parents=True, exist_ok=True)
+            t.write_bytes(fp.read())
+        dest = work / "restored"
+        (dest / "slot1.sav").parent.mkdir(parents=True)
+        (dest / "slot1.sav").write_bytes(b"older local copy")
+        r = subprocess.run([str(driver), "fetch", str(cloud2), str(dest), str(back), app, acct], capture_output=True, text=True)
+        print(r.stdout.strip(), r.stderr.strip())
+        check(r.returncode == 0, "driver downloaded Legendary's snapshot")
+        same = all((dest / rel).read_bytes() == data for rel, data in files2.items())
+        check(same, f"all {len(files2)} files restored byte for byte")
+        check((back / "slot1.sav").read_bytes() == b"older local copy", "the file it replaced was backed up first")
+        check(int((dest / "slot1.sav").stat().st_mtime) == int(datetime(2026, 10, 14, 8, 0, 0).replace(tzinfo=__import__("datetime").timezone.utc).timestamp()),
+              "restored files take the snapshot's date")
+
+        # 3b. a damaged chunk must stop the download before anything is written
+        victim = next((game2 / "ChunksV4").rglob("*.chunk"))
+        victim.write_bytes(victim.read_bytes()[:-50])
+        dest3 = work / "restored3"
+        r = subprocess.run([str(driver), "fetch", str(cloud2), str(dest3), str(work / "b3"), app, acct], capture_output=True, text=True)
+        check(r.returncode != 0 and not dest3.exists(), "a damaged chunk aborts the download and writes nothing")
+    finally:
+        shutil.rmtree(work, ignore_errors=True)
+    print("ALL OK" if failures == 0 else f"{failures} FAILED")
+    sys.exit(1 if failures else 0)
+
+
+if __name__ == "__main__":
+    main()
diff -ruN a/tests/host/epic-cloud/main.swift b/tests/host/epic-cloud/main.swift
--- a/tests/host/epic-cloud/main.swift	1970-01-01 01:00:00.000000000 +0100
+++ b/tests/host/epic-cloud/main.swift	2026-10-15 18:57:18.149240857 +0200
@@ -0,0 +1,126 @@
+// Host driver for tests/host/check-epic-cloud.py: runs the production EpicCloudSaves.swift against a
+// directory standing in for Epic's datastorage service.
+//
+//   driver selftest
+//   driver pack  SRC CLOUD APP ACCOUNT FOLDER [YYYY.MM.dd-HH.mm.ss]   upload SRC as a new snapshot
+//   driver fetch CLOUD DEST BACKUP APP ACCOUNT                         download the newest snapshot
+
+import Foundation
+
+struct DirTransport: EpicCloudTransport {
+    var root: URL
+    var prefix: String   // remote folder of the game, e.g. "ACC/savesync/APP"
+
+    func list(app: String) async throws -> [EpicCloudObject] {
+        let base = root.appendingPathComponent(prefix)
+        guard let walker = FileManager.default.enumerator(at: base, includingPropertiesForKeys: [.isRegularFileKey]) else { return [] }
+        var out = [EpicCloudObject]()
+        for case let url as URL in walker where (try? url.resourceValues(forKeys: [.isRegularFileKey]).isRegularFile) == true {
+            let rel = String(url.path.dropFirst(base.path.count + 1))
+            out.append(EpicCloudObject(path: prefix + "/" + rel, readLink: url.path, writeLink: nil))
+        }
+        return out.sorted { $0.path < $1.path }
+    }
+    func read(_ object: EpicCloudObject) async throws -> Data { try Data(contentsOf: URL(fileURLWithPath: object.readLink!)) }
+    func writeTargets(app: String, paths: [String]) async throws -> [EpicCloudObject] {
+        paths.map { EpicCloudObject(path: $0, readLink: nil, writeLink: root.appendingPathComponent(prefix + "/" + $0).path) }
+    }
+    func write(_ object: EpicCloudObject, data: Data) async throws {
+        let url = URL(fileURLWithPath: object.writeLink!)
+        try FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+        try data.write(to: url)
+    }
+}
+
+var failures = 0
+func check(_ ok: Bool, _ what: String) {
+    print(ok ? "ok   " : "FAIL ", what)
+    if !ok { failures += 1 }
+}
+
+func selftest() {
+    // the decision table
+    typealias V = EpicSaveVerdict
+    let a = ["s1": "aa"], b = ["s1": "bb"], c = ["s1": "cc"]
+    let base = EpicSaveBaseline(device: a, cloud: a, snapshot: "x")
+    check(EpicSavePlanner.decide(device: [:], cloud: nil, baseline: nil) == V.empty, "nothing anywhere: empty")
+    check(EpicSavePlanner.decide(device: a, cloud: a, baseline: nil) == V.inSync, "same without a record: in sync")
+    check(EpicSavePlanner.decide(device: [:], cloud: a, baseline: nil) == V.download, "empty device, cloud has saves: download")
+    check(EpicSavePlanner.decide(device: a, cloud: nil, baseline: nil) == V.upload, "no cloud save yet: upload")
+    check(EpicSavePlanner.decide(device: a, cloud: b, baseline: nil) == V.conflict, "differ, no record: conflict")
+    check(EpicSavePlanner.decide(device: a, cloud: b, baseline: base) == V.download, "only the cloud changed: download")
+    check(EpicSavePlanner.decide(device: b, cloud: a, baseline: base) == V.upload, "only the device changed: upload")
+    check(EpicSavePlanner.decide(device: b, cloud: c, baseline: base) == V.conflict, "both changed: conflict")
+    check(EpicSavePlanner.decide(device: a, cloud: nil, baseline: base) == V.inSync, "cloud emptied elsewhere: left alone")
+    check(EpicSavePlanner.decide(device: b, cloud: nil, baseline: base) == V.upload, "cloud emptied, device changed: upload")
+    let extra = EpicSaveBaseline(device: ["s1": "aa", "local": "zz"], cloud: a, snapshot: "x")
+    check(EpicSavePlanner.decide(device: ["s1": "aa", "local": "zz"], cloud: a, baseline: extra) == V.inSync, "device extras recorded by a download stay in sync")
+
+    // filters (utils/savegame_helper.py _filename_matches)
+    check(EpicSaveConfig.matches("Saves/slot1.sav", ["*.sav"]), "glob matches")
+    check(EpicSaveConfig.matches("Saves/slot1.sav", ["Saves/"]), "directory prefix matches")
+    check(EpicSaveConfig.matches("a/b/config.ini", ["config.ini"]), "suffix matches")
+    check(!EpicSaveConfig.matches("a/b/other.txt", ["*.sav", "Saves/"]), "no match")
+    let inc = EpicSaveConfig(folder: "x", include: ["*.sav"], exclude: [])
+    let exc = EpicSaveConfig(folder: "x", include: [], exclude: ["*.log"])
+    check(inc.includes("a.sav") && !inc.includes("a.log"), "include list")
+    check(exc.includes("a.sav") && !exc.includes("a.log"), "exclude list")
+    let attrs: [String: Any] = ["CloudSaveFolder": ["value": "{AppData}/Game/Saved"], "CloudIncludeList": ["value": "*.sav, *.dat"]]
+    let cfg = EpicSaveConfig.from(customAttributes: attrs)
+    check(cfg?.folder == "{AppData}/Game/Saved" && cfg?.include == ["*.sav", "*.dat"], "customAttributes parsed")
+    check(EpicSaveConfig.from(customAttributes: ["Other": ["value": "x"]]) == nil, "no CloudSaveFolder: no cloud saves")
+
+    // save folder variables
+    let tmp = FileManager.default.temporaryDirectory.appendingPathComponent("epic-cloud-paths-\(getpid())")
+    let drive = tmp.appendingPathComponent("drive_c"), user = drive.appendingPathComponent("users/steamuser")
+    try? FileManager.default.createDirectory(at: user.appendingPathComponent("AppData/Local/MyGame"), withIntermediateDirectories: true)
+    defer { try? FileManager.default.removeItem(at: tmp) }
+    let paths = EpicSavePaths(drive: drive, userFolder: user, installFolder: drive.appendingPathComponent("Program Files/Epic Games/G"), accountID: "ACC123")
+    check(paths.resolve("{AppData}/mygame/Saved")?.path.hasSuffix("users/steamuser/AppData/Local/MyGame/Saved") == true, "{AppData} resolves, case-insensitively")
+    check(paths.resolve("{UserDir}\\Games\\{EpicID}")?.path.hasSuffix("users/steamuser/Documents/Games/ACC123") == true, "{UserDir} and {EpicID}")
+    check(paths.resolve("{UserSavedGames}/G")?.path.hasSuffix("users/steamuser/Saved Games/G") == true, "{UserSavedGames}")
+    check(paths.resolve("{InstallDir}/Saves")?.path.hasSuffix("Epic Games/G/Saves") == true, "{InstallDir}")
+    check(paths.resolve("{AppData}/../Roaming/G")?.path.hasSuffix("users/steamuser/AppData/Roaming/G") == true, "{AppData}/../Roaming stays inside the prefix")
+    check(paths.resolve("{AppData}/../../../../../../../etc") == nil, "a path leaving drive_c is refused")
+    check(paths.resolve("{Nonsense}/x") == nil && paths.resolve("C:/x") == nil, "unknown variables and absolute paths are refused")
+
+    // chunk and hash basics
+    check(EpicSaveWriter.rollingHash(Data()) == 0, "rolling hash of nothing is 0")
+    let sample = Data("hello epic".utf8)
+    if let built = try? EpicSaveWriter.chunk(sample, guid: [1, 2, 3, 4]) {
+        check(built.file.count > 66 && built.path.hasPrefix("ChunksV4/"), "chunk file built (\(built.file.count) bytes, \(built.path))")
+        let parsed = try? EpicChunk.parse(built.file)
+        check(parsed?.count == EpicSaveWriter.chunkSize && parsed?.prefix(sample.count) == sample, "the reader inflates it back, padded to 1 MiB")
+    } else { check(false, "chunk built") }
+}
+
+func run() async throws {
+    let args = CommandLine.arguments
+    guard args.count >= 2 else { print("usage"); exit(2) }
+    switch args[1] {
+    case "selftest":
+        selftest()
+        print(failures == 0 ? "ALL OK" : "\(failures) FAILED")
+        exit(failures == 0 ? 0 : 1)
+    case "pack":
+        let src = URL(fileURLWithPath: args[2]), cloud = URL(fileURLWithPath: args[3]), app = args[4], account = args[5], folder = args[6]
+        let date = args.count > 7 ? EpicCloudSaves.date(ofBuildVersion: args[7]) ?? Date() : Date()
+        let config = EpicSaveConfig(folder: folder, include: [], exclude: [])
+        let saves = try EpicSaveScan.scan(src, config: config)
+        let transport = DirTransport(root: cloud, prefix: "\(account)/savesync/\(app)")
+        let result = try await EpicCloudSaves.upload(saves, app: app, accountID: account, config: config, transport: transport, date: date)
+        print("packed \(result.files) files as \(result.version)")
+    case "fetch":
+        let cloud = URL(fileURLWithPath: args[2]), dest = URL(fileURLWithPath: args[3]), backup = URL(fileURLWithPath: args[4])
+        let app = args[5], account = args[6]
+        let transport = DirTransport(root: cloud, prefix: "\(account)/savesync/\(app)")
+        guard let (snapshot, all) = try await EpicCloudSaves.latest(app: app, transport: transport) else { print("no snapshot"); exit(3) }
+        let result = try await EpicCloudSaves.download(snapshot, all: all, into: dest, backup: backup, transport: transport)
+        print("fetched \(result.files) files from \(snapshot.buildVersion), \(result.backedUp) backed up")
+    default:
+        print("unknown command"); exit(2)
+    }
+}
+
+Task { do { try await run() } catch { print("ERROR: \(error)"); exit(1) }; exit(0) }
+RunLoop.main.run()
