+static const char *skip_spaces(const char *p)
+{
+    while (*p == ' ' || *p == '	') ++p;
+    return p;
+}
+
+/* Up to 10 decimal digits within [0, max]; no sign, no leading zeros beyond "0". */
+static const char *parse_bounded(const char *p, uint32_t max, uint32_t *value)
+{
+    uint32_t v = 0;
+    unsigned digits = 0;
+    while (*p >= '0' && *p <= '9') {
+        unsigned d = (unsigned)(*p - '0');
+        if (digits == 1 && v == 0) return NULL;
+        if (++digits > 10 || v > (max - d) / 10) return NULL;
+        v = v * 10 + d;
+        ++p;
+    }
+    if (!digits) return NULL;
+    *value = v;
+    return p;
+}
+
+int sh_find_launch_option(const char *list, uint32_t appid, uint32_t *option)
+{
+    if (!list || !option) return -1;
+    uint32_t seen[64];
+    unsigned count = 0;
+    int found = 0;
+    uint32_t chosen = 0;
+    const char *p = skip_spaces(list);
+    if (!*p) return 0;
+    for (;;) {
+        uint32_t app = 0, key = 0;
+        p = parse_bounded(p, UINT32_MAX, &app);
+        if (!p || app == 0) return -1;
+        p = skip_spaces(p);
+        if (*p++ != ':') return -1;
+        p = parse_bounded(skip_spaces(p), (uint32_t)INT32_MAX, &key);
+        if (!p) return -1;
+        for (unsigned i = 0; i < count; ++i)
+            if (seen[i] == app) return -1;
+        if (count == 64) return -1;
+        seen[count++] = app;
+        if (app == appid) { found = 1; chosen = key; }
+        p = skip_spaces(p);
+        if (!*p) break;
+        if (*p++ != ',') return -1;
+        p = skip_spaces(p);
+    }
+    if (found) *option = chosen;
+    return found;
+}
+
